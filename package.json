{
  "name": "pi-email-subagent",
  "version": "0.1.0",
  "description": "Persistent parallel Pi subagents coordinated through virtual email",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "subagent",
    "agents",
    "multi-agent"
  ],
  "license": "MIT",
  "author": "pi-email-subagent contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metzzo/pi-email-subagent.git"
  },
  "homepage": "https://github.com/metzzo/pi-email-subagent#readme",
  "bugs": {
    "url": "https://github.com/metzzo/pi-email-subagent/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test test/**/*.test.ts",
    "test:unit": "tsx --test test/unit/**/*.test.ts",
    "test:integration": "tsx --test test/integration/**/*.test.ts",
    "test:e2e": "tsx --test test/e2e/**/*.test.ts",
    "test:coverage": "mkdir -p .test-workspaces && tsx --test --test-concurrency=1 --experimental-test-isolation=none --experimental-test-coverage --test-reporter=spec --test-reporter-destination=.test-workspaces/coverage-tests.log --test-reporter=lcov --test-reporter-destination=.test-workspaces/coverage.lcov test/**/*.test.ts && tsx scripts/coverage-gate.ts .test-workspaces/coverage.lcov coverage-thresholds.json",
    "test:package": "tsx scripts/package-smoke.ts",
    "check:package": "tsx scripts/package-policy.ts",
    "test:live": "tsx scripts/live-e2e.ts",
    "check:secrets": "gitleaks git --config=.gitleaks.toml --redact --no-banner .",
    "check:licenses": "tsx scripts/check-dependency-licenses.ts",
    "validate": "npm run check && npm run check:licenses && npm run test:coverage && npm run test:package",
    "prepublishOnly": "npm run validate"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/node": "^22.15.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "proper-lockfile": "^4.1.2"
  }
}
